DB_HOST=db
DB_PORT=5432
DB_NAME=mytimeline
DB_USER=mytimelineuser
DB_PASSWORD=mytimelinepassword

# JWT の署名鍵。HS256 のため 32 バイト（256bit）以上必要。
# 本番環境では必ず推測不可能な値に差し替えること。
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# アクセストークン（Authorization ヘッダ）の有効期間（分）
JWT_ACCESS_EXPIRATION_MINUTES=15
# リフレッシュトークン（httpOnly Cookie）の有効期間（日）
JWT_REFRESH_EXPIRATION_DAYS=14
# リフレッシュトークン Cookie の Secure 属性。HTTPS の本番では true にすること
REFRESH_COOKIE_SECURE=false

# CORS の許可オリジン（カンマ区切り・ワイルドカード可）。
# 本番では配信ドメインだけに絞ること（例: https://xxxx.cloudfront.net）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:*

# 画像ストレージ。ローカルは docker-compose の MinIO、本番は AWS S3。
# S3_ENDPOINT はアプリからの接続先。本番（実 S3）では空にすること
S3_ENDPOINT=http://minio:9000
# 署名付き URL に載るホスト。ブラウザから到達できる必要がある。
# 内部ホスト（minio:9000）で署名するとブラウザから開けないため必ず分ける
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=mytimeline-images
S3_REGION=ap-northeast-1
# MinIO のログイン情報も兼ねる。本番では空にして EC2 の IAM ロールを使うこと
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# MinIO では true 必須。実 S3 では false でよい
S3_PATH_STYLE_ACCESS=true
