# Claude Code の設定はローカル固有（絶対パスを含む）なので共有しない。
# ただし skills/ は手順書としてチームで共有しレビュー対象にするため追跡する
.claude/*
!.claude/skills/
.DS_Store

# 環境変数（機密情報を含むためコミットしない）
.env

# バックエンド
backend/build/
backend/.gradle/

# フロントエンド
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Terraform（state はアカウント ID 等を含むためコミットしない。
# .terraform.lock.hcl はバージョン固定のため追跡する）
terraform/.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
crash.log
crash.*.log
*.tfplan
